# =============================================================================
# lichtar — .env.example
# Copy this file to .env and edit it there. .env is gitignored — it's
# your personal, local configuration and is never tracked or overwritten
# by lichtar update or install.sh.
#
#   cp .env.example .env
# =============================================================================

# ── UI ────────────────────────────────────────────────────────────────────────
LICHTAR_THEME=catppuccin-mocha

# ── System ────────────────────────────────────────────────────────────────────
LICHTAR_EDITOR=micro           # default $EDITOR. 'v' always opens nvim regardless
LICHTAR_YAZI=1                 # 1 = enable yazi integration
LICHTAR_GIT_AHEAD=1            # 1 = show ahead/behind in prompt
LICHTAR_LANG_DETECT=1          # 1 = enable language version detection

# ── Debug ─────────────────────────────────────────────────────────────────────
LICHTAR_DEBUG=0                # 1 = verbose module loading
LICHTAR_PROFILE=0              # 1 = show startup timing per module
